# Netlify-style redirects, honoured by Render static sites.
#
# The export is built with trailingSlash: true, so /planner/ is the canonical
# route and lives at planner/index.html. A request for the extensionless
# /planner has no matching file, and the host falls back to index.html, which
# renders the home page. These rules make the extensionless form and the old
# flat .html form resolve to the canonical URL instead.
/planner    /planner/           301
/planner.html  /planner/        301
/terms      /terms/             301
/terms.html /terms/             301
/privacy-policy     /privacy-policy/  301
/privacy-policy.html /privacy-policy/ 301
