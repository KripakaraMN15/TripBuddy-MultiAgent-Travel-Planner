# ---- TripBuddy AI configuration -------------------------------------------
# Copy this file to .env and fill in the values. Never commit .env.

# Required: LLM used by the supervisor, specialists, and final response agent.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Required for the hotel agent (web search via the Tavily MCP server).
TAVILY_API_KEY=tvly-...

# Required for the flight agent (airports, airlines, live schedules).
# AVIATIONSTACK_API_KEY is also accepted.
AVIATION_STACK_API_KEY=

# Required for the weather agent (current conditions and 5-day forecast).
OPENWEATHER_API_KEY=

# Optional: PostgreSQL checkpoint store. Omit to run fully in-memory, which
# means in-progress drafts are lost whenever the server restarts.
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Optional: external `uvx` launcher, required for the AviationStack MCP server.
# The launcher name is fixed; install `uv` so that `uvx` is on PATH.
# https://docs.astral.sh/uv/

# ---- Web server -------------------------------------------------------------
# Comma-separated list of additional CORS origins.
# EXTRA_ALLOWED_ORIGINS=https://your-frontend.example.com

# Absolute site URL, used for robots.txt, sitemap.xml, and llms.txt.
# This is the STATIC site, and it is also the origin allowed through CORS.
# SITE_URL=https://tripbuddy-multiagent-travel-planner-1.onrender.com

# ---- Deployment notes -------------------------------------------------------
# The static site and the API are two different Render services:
#   static site -> https://tripbuddy-multiagent-travel-planner-1.onrender.com
#   API         -> https://tripbuddy-multiagent-travel-planner.onrender.com
#
# frontend/.env.production must point NEXT_PUBLIC_API_BASE_URL at the API
# service, NOT at the static site. Pointing it at the static site makes
# /api/travel return the exported HTML, which the planner reads as an empty
# response and appears to do nothing. The build ignores a value that matches
# the site URL, but set it correctly anyway:
#   NEXT_PUBLIC_API_BASE_URL=https://tripbuddy-multiagent-travel-planner.onrender.com
#
# Because NEXT_PUBLIC_* is inlined at build time, frontend/scripts/set-api-base.mjs
# can also rewrite the value inside the built HTML, so a deployed static site
# can be repointed by running `API_BASE_URL=<url> npm run build`.
#
# On Render set SITE_URL and EXTRA_ALLOWED_ORIGINS on the API service to the
# static site URL so CORS allows the browser.

# Per-client rate limit applied to /api/travel and /api/travel/approve.
# RATE_LIMIT_REQUESTS=10
# RATE_LIMIT_WINDOW_SECONDS=300

# Set to true only when a proxy sets X-Forwarded-For for every request.
# TRUST_PROXY=false

# Force HTTPS redirects (enable on production).
# FORCE_HTTPS=false

# LOG_LEVEL=INFO
